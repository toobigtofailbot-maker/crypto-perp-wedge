                  "bars_parameter_ref": "center_lookback_bars"
                }
              },
              "scale_operand": {
                "operand_type": "indicator_ref",
                "ref": "stddev",
                "field": "value",
                "timeframe": null,
                "lookback": {
                  "bars_parameter_ref": "vol_lookback_bars"
                }
              },
              "zero_scale_policy": "null_output"
            },
            "operator": "lt",
            "right_operand": {
              "operand_type": "constant",
              "ref": -1.5,
              "field": null,
              "timeframe": null,
              "lookback": null
            },
            "units": "z_score",
            "notes": "Long entry when close is more than 1.5 rolling standard deviations below SMA(center_lookback_bars)."
          }
        ],
        "subgroups": [],
        "notes": "Explicit long-side z-score entry group; no compiler mirroring.",
        "side": "long"
