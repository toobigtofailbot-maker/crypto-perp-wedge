{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crypto-perp-wedge.local/research/schemas/paper_state.schema.json",
  "title": "Paper State Snapshot",
  "description": "Disconnected paper-state and reconciliation snapshot artifact shape. This schema validates local data shape only and creates no paper engine, reconciliation engine, runtime, live, OMS, broker, exchange, order execution, capital, candidate promotion, or trading authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_state_id",
    "snapshot_time_utc",
    "mode",
    "candidate_ref",
    "strategy_ref",
    "data_context",
    "expected_state",
    "observed_state",
    "orders",
    "fills",
    "account",
    "risk_state",
    "drift",
    "non_authority_declaration",
    "validation_summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "paper_state.v1"
    },
    "paper_state_id": {
      "type": "string",
      "pattern": "^PAPER-STATE-(EXAMPLE-|FIXTURE-)?[0-9]{4}$"
    },
    "snapshot_time_utc": {
      "$ref": "#/definitions/utc_timestamp"
    },
    "mode": {
      "type": "string",
      "enum": ["example_fixture", "test_fixture", "paper_simulated", "shadow_observed", "archived"]
    },
    "candidate_ref": {
      "oneOf": [
        { "$ref": "#/definitions/artifact_ref" },
        { "type": "null" }
      ]
    },
    "strategy_ref": {
      "oneOf": [
        { "$ref": "#/definitions/artifact_ref" },
        { "type": "null" }
      ]
    },
    "data_context": {
      "$ref": "#/definitions/data_context"
    },
    "expected_state": {
      "$ref": "#/definitions/expected_state"
    },
    "observed_state": {
      "$ref": "#/definitions/observed_state"
    },
    "orders": {
      "type": "array",
      "items": { "$ref": "#/definitions/order" }
    },
    "fills": {
      "type": "array",
      "items": { "$ref": "#/definitions/fill" }
    },
    "account": {
      "$ref": "#/definitions/account"
    },
    "risk_state": {
      "$ref": "#/definitions/risk_state"
    },
    "drift": {
      "$ref": "#/definitions/drift"
    },
    "non_authority_declaration": {
      "$ref": "#/definitions/non_authority_declaration"
    },
    "validation_summary": {
      "$ref": "#/definitions/validation_summary"
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "candidate_ref": { "$ref": "#/definitions/artifact_ref" }
          }
        },
        {
          "properties": {
            "strategy_ref": { "$ref": "#/definitions/artifact_ref" }
          }
        }
      ]
    }
  ],
  "definitions": {
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "repo_relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "artifact_id", "artifact_path", "relationship", "authority_boundary"],
      "properties": {
        "artifact_type": {
          "type": "string",
          "enum": [
            "candidate",
            "strategy_spec",
            "signal",
            "config",
            "data_feed",
            "paper_state",
            "paper_run",
            "design_doc",
            "status_entry",
            "test_fixture",
            "other"
          ]
        },
        "artifact_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "artifact_path": {
          "oneOf": [
            { "$ref": "#/definitions/repo_relative_path" },
            { "type": "null" }
          ]
        },
        "relationship": {
          "type": "string",
          "enum": [
            "source_lineage",
            "expected_state_source",
            "observed_state_source",
            "drift_evidence",
            "fixture_context",
            "non_authoritative_context"
          ]
        },
        "authority_boundary": {
          "type": "string",
          "enum": ["fixture_only", "review_reference_only", "non_authoritative_context"]
        },
        "identity_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "data_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "instrument",
        "primary_timeframe",
        "source_commit",
        "data_feed_ref",
        "latest_bar_time_utc",
        "data_freshness_status",
        "notes"
      ],
      "properties": {
        "market": {
          "type": "string",
          "const": "crypto_perpetual"
        },
        "instrument": {
          "type": "string",
          "const": "BTCUSDT"
        },
        "primary_timeframe": {
          "type": ["string", "null"],
          "enum": ["15m", "30m", "1h", "4h", "1d", null]
        },
        "source_commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "data_feed_ref": {
          "$ref": "#/definitions/artifact_ref"
        },
        "latest_bar_time_utc": {
          "oneOf": [
            { "$ref": "#/definitions/utc_timestamp" },
            { "type": "null" }
          ]
        },
        "data_freshness_status": {
          "type": "string",
          "enum": ["fresh", "stale", "unknown", "fixture_only"]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "position_side": {
      "type": "string",
      "enum": ["flat", "long", "short"]
    },
    "expected_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "source_signal_refs", "notes"],
      "properties": {
        "position": {
          "$ref": "#/definitions/expected_position"
        },
        "source_signal_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/artifact_ref" }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "observed_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "venue_account_source", "simulated_or_fixture_only", "notes"],
      "properties": {
        "position": {
          "$ref": "#/definitions/observed_position"
        },
        "venue_account_source": {
          "type": "string",
          "enum": ["fixture_only", "paper_simulation", "shadow_read_only_placeholder", "archived"]
        },
        "simulated_or_fixture_only": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "expected_position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "quantity", "average_entry_price", "notional", "leverage_intent"],
      "properties": {
        "side": { "$ref": "#/definitions/position_side" },
        "quantity": { "type": "number", "minimum": 0 },
        "average_entry_price": { "type": ["number", "null"], "minimum": 0 },
        "notional": { "type": "number", "minimum": 0 },
        "leverage_intent": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "observed_position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "quantity", "average_entry_price", "notional"],
      "properties": {
        "side": { "$ref": "#/definitions/position_side" },
        "quantity": { "type": "number", "minimum": 0 },
        "average_entry_price": { "type": ["number", "null"], "minimum": 0 },
        "notional": { "type": "number", "minimum": 0 }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_id",
        "client_order_id",
        "side",
        "order_type",
        "status",
        "quantity",
        "price",
        "stop_price",
        "reduce_only",
        "post_only",
        "timestamp_utc",
        "mode_source"
      ],
      "properties": {
        "order_id": { "$ref": "#/definitions/non_empty_string" },
        "client_order_id": { "$ref": "#/definitions/non_empty_string" },
        "side": { "type": "string", "enum": ["buy", "sell"] },
        "order_type": { "type": "string", "enum": ["market", "limit", "stop", "stop_limit"] },
        "status": {
          "type": "string",
          "enum": ["planned", "working", "partially_filled", "filled", "canceled", "rejected", "expired", "terminal_unknown"]
        },
        "quantity": { "type": "number", "minimum": 0 },
        "price": { "type": ["number", "null"], "minimum": 0 },
        "stop_price": { "type": ["number", "null"], "minimum": 0 },
        "reduce_only": { "type": "boolean" },
        "post_only": { "type": "boolean" },
        "timestamp_utc": { "$ref": "#/definitions/utc_timestamp" },
        "mode_source": {
          "type": "string",
          "enum": ["fixture_only", "paper_simulated", "shadow_observed", "archived"]
        }
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fill_id",
        "order_id",
        "client_order_id",
        "side",
        "quantity",
        "price",
        "fee",
        "fee_currency",
        "timestamp_utc",
        "liquidity_flag",
        "simulated"
      ],
      "properties": {
        "fill_id": { "$ref": "#/definitions/non_empty_string" },
        "order_id": { "$ref": "#/definitions/non_empty_string" },
        "client_order_id": { "$ref": "#/definitions/non_empty_string" },
        "side": { "type": "string", "enum": ["buy", "sell"] },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "price": { "type": "number", "exclusiveMinimum": 0 },
        "fee": { "type": "number", "minimum": 0 },
        "fee_currency": { "$ref": "#/definitions/non_empty_string" },
        "timestamp_utc": { "$ref": "#/definitions/utc_timestamp" },
        "liquidity_flag": { "type": ["string", "null"], "enum": ["maker", "taker", "unknown", null] },
        "simulated": { "type": "boolean" }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equity",
        "cash_balance",
        "margin_used",
        "available_margin",
        "realized_pnl",
        "unrealized_pnl",
        "funding_accrued",
        "funding_paid",
        "fees_paid",
        "slippage_estimate",
        "currency"
      ],
      "properties": {
        "equity": { "type": "number" },
        "cash_balance": { "type": "number" },
        "margin_used": { "type": "number", "minimum": 0 },
        "available_margin": { "type": "number" },
        "realized_pnl": { "type": "number" },
        "unrealized_pnl": { "type": "number" },
        "funding_accrued": { "type": "number" },
        "funding_paid": { "type": "number" },
        "fees_paid": { "type": "number", "minimum": 0 },
        "slippage_estimate": { "type": ["number", "null"] },
        "currency": { "$ref": "#/definitions/non_empty_string" }
      }
    },
    "cap_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "limit", "observed_value", "notes"],
      "properties": {
        "status": { "type": "string", "enum": ["pass", "warning", "breach", "unknown", "fixture_only"] },
        "limit": { "type": ["number", "null"] },
        "observed_value": { "type": ["number", "null"] },
        "notes": { "type": "string" }
      }
    },
    "freshness_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_seen_utc", "max_age_seconds", "observed_age_seconds", "notes"],
      "properties": {
        "status": { "type": "string", "enum": ["fresh", "stale", "unknown", "fixture_only"] },
        "last_seen_utc": {
          "oneOf": [
            { "$ref": "#/definitions/utc_timestamp" },
            { "type": "null" }
          ]
        },
        "max_age_seconds": { "type": ["integer", "null"], "minimum": 0 },
        "observed_age_seconds": { "type": ["integer", "null"], "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "risk_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safe_mode_state",
        "no_new_intent",
        "operator_halt",
        "max_position_cap",
        "daily_loss_cap",
        "stale_data_cap",
        "last_heartbeat_utc",
        "bar_freshness",
        "signal_freshness"
      ],
      "properties": {
        "safe_mode_state": {
          "type": "string",
          "enum": ["normal", "no_new_intent", "safe_mode", "operator_halt", "frozen", "fixture_only"]
        },
        "no_new_intent": { "type": "boolean" },
        "operator_halt": { "type": "boolean" },
        "max_position_cap": { "$ref": "#/definitions/cap_status" },
        "daily_loss_cap": { "$ref": "#/definitions/cap_status" },
        "stale_data_cap": { "$ref": "#/definitions/cap_status" },
        "last_heartbeat_utc": {
          "oneOf": [
            { "$ref": "#/definitions/utc_timestamp" },
            { "type": "null" }
          ]
        },
        "bar_freshness": { "$ref": "#/definitions/freshness_status" },
        "signal_freshness": { "$ref": "#/definitions/freshness_status" }
      }
    },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "severity", "reason", "evidence_refs"],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "none",
            "expected_position_mismatch",
            "observed_position_mismatch",
            "open_order_mismatch",
            "fill_mismatch",
            "equity_mismatch",
            "margin_mismatch",
            "pnl_mismatch",
            "funding_mismatch",
            "stale_data",
            "unknown"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "halt_required"]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/artifact_ref" }
        }
      }
    },
    "non_authority_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_paper_engine",
        "not_runtime_authority",
        "not_live_authority",
        "not_broker_exchange_authority",
        "not_capital_authority",
        "not_order_execution_authority",
        "not_candidate_promotion_authority",
        "not_trading_recommendation",
        "notes"
      ],
      "properties": {
        "not_paper_engine": { "type": "boolean", "const": true },
        "not_runtime_authority": { "type": "boolean", "const": true },
        "not_live_authority": { "type": "boolean", "const": true },
        "not_broker_exchange_authority": { "type": "boolean", "const": true },
        "not_capital_authority": { "type": "boolean", "const": true },
        "not_order_execution_authority": { "type": "boolean", "const": true },
        "not_candidate_promotion_authority": { "type": "boolean", "const": true },
        "not_trading_recommendation": { "type": "boolean", "const": true },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_only",
        "real_paper_state_artifact_committed",
        "paper_engine_implemented",
        "reconciliation_engine_implemented",
        "runtime_authority_created",
        "paper_live_authority_created",
        "broker_exchange_authority_created",
        "capital_authority_created",
        "order_execution_authority_created",
        "notes"
      ],
      "properties": {
        "fixture_only": { "type": "boolean" },
        "real_paper_state_artifact_committed": { "type": "boolean", "const": false },
        "paper_engine_implemented": { "type": "boolean", "const": false },
        "reconciliation_engine_implemented": { "type": "boolean", "const": false },
        "runtime_authority_created": { "type": "boolean", "const": false },
        "paper_live_authority_created": { "type": "boolean", "const": false },
        "broker_exchange_authority_created": { "type": "boolean", "const": false },
        "capital_authority_created": { "type": "boolean", "const": false },
        "order_execution_authority_created": { "type": "boolean", "const": false },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
