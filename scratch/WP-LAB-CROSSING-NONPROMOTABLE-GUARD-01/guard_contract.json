  "required_pr583_baseline_semantics": {
    "construction_payload": true,
    "non_promotable": true,
    "candidate_eligible": false,
    "promotion_eligible": false,
    "paper_live_eligible": false,
    "canonical_crossing_allowed": false,
    "edge_claim_allowed": false
  },
  "allowed_writes": [
    "scratch/WP-AGENT-CANONICAL-CROSSING-BUILD-01/outputs/** for fixture crossing outputs after the guard passes",
