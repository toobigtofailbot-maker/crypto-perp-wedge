{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gate_q_approval.schema.json",
  "title": "Gate-Q exact-content queue-admission approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_id", "approval_artifact_target_path", "approved_by", "approved_at", "approval_scope", "artifact_refs", "denominator", "dataset", "budget", "priority", "queue_target", "proposed_queue_item", "lineage", "approval_core_sha256", "approval_core_hash_scope", "approval_core_canonicalization", "exact_content_and_target_only", "append_only", "single_use_approval_id", "authority_flags"],
  "properties": {
    "schema_version": {"const": "gate_q_queue_admission_approval_v1"},
    "approval_id": {"type": "string", "pattern": "^GATE-Q-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "approval_artifact_target_path": {"type": "string", "pattern": "^research/queue/gate_q_approvals/GATE-Q-[A-Z0-9][A-Z0-9-]{2,63}\\.gate_q_approval\\.json$"},
    "approved_by": {"const": "Karl"},
    "approved_at": {"type": "string", "format": "date-time"},
    "approval_scope": {"const": "one_append_only_queue_admission"},
    "artifact_refs": {"type": "object", "additionalProperties": false, "required": ["strategy_spec", "gate_c_crossing_audit_record", "variant_manifest", "sweep_plan"], "properties": {"strategy_spec": {"$ref": "#/definitions/ref"}, "gate_c_crossing_audit_record": {"$ref": "#/definitions/gate_c_audit_record_ref"}, "variant_manifest": {"$ref": "#/definitions/ref"}, "sweep_plan": {"$ref": "#/definitions/ref"}, "variant_planning_approval": {"$ref": "#/definitions/variant_planning_approval_ref"}}},
    "denominator": {"$ref": "#/definitions/denominator"},
    "dataset": {"$ref": "#/definitions/dataset"},
    "budget": {"$ref": "#/definitions/budget"},
    "priority": {"enum": ["normal", "expedited"]},
    "queue_target": {"const": "offline_research"},
    "proposed_queue_item": {"type": "object", "additionalProperties": false, "required": ["queue_item_id", "target_path", "bytes_sha256", "byte_encoding"], "properties": {"queue_item_id": {"$ref": "#/definitions/queue_id"}, "target_path": {"type": "string", "pattern": "^research/queue/admissions/QI-[0-9]{8}-[A-Z0-9]{8}\\.queue_item\\.json$"}, "bytes_sha256": {"$ref": "#/definitions/hash"}, "byte_encoding": {"const": "utf8_exact_file_bytes"}}},
    "lineage": {"type": "object", "additionalProperties": false, "required": ["source_draft", "review_trail", "eligibility_report", "gate_c_approval"], "properties": {"source_draft": {"$ref": "#/definitions/ref"}, "review_trail": {"$ref": "#/definitions/ref"}, "eligibility_report": {"$ref": "#/definitions/ref"}, "gate_c_approval": {"$ref": "#/definitions/ref"}}},
    "approval_core_sha256": {"$ref": "#/definitions/hash"},
    "approval_core_hash_scope": {"const": "gate_q_approval_core_v1"},
    "approval_core_canonicalization": {"const": "repo_canonical_json_v1"},
    "exact_content_and_target_only": {"const": true}, "append_only": {"const": true}, "single_use_approval_id": {"const": true},
    "authority_flags": {"$ref": "#/definitions/flags"}
  },
  "definitions": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "queue_id": {"type": "string", "pattern": "^QI-[0-9]{8}-[A-Z0-9]{8}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/definitions/hash"}}},
    "variant_planning_approval_ref": {"type": "object", "additionalProperties": false, "required": ["approval_id", "path", "sha256", "contract_core_sha256"], "properties": {"approval_id": {"type": "string", "pattern": "^VPAPP-[0-9]{8}-[A-Z0-9]{8}$"}, "path": {"type": "string", "pattern": "^research/strategy_spec_variant_planning_approvals/VPAPP-[0-9]{8}-[A-Z0-9]{8}\\.variant_planning_approval\\.json$"}, "sha256": {"$ref": "#/definitions/hash"}, "contract_core_sha256": {"$ref": "#/definitions/hash"}}},
    "gate_c_audit_record_ref": {"type": "object", "additionalProperties": false, "required": ["audit_path", "line_number", "raw_record_sha256", "gate_c_approval_id", "strategy_spec_id", "canonical_target_path"], "properties": {"audit_path": {"const": "research/canonical_crossing_audit/strategy_spec_writes.jsonl"}, "line_number": {"type": "integer", "minimum": 1}, "raw_record_sha256": {"$ref": "#/definitions/hash"}, "gate_c_approval_id": {"type": "string", "minLength": 1}, "strategy_spec_id": {"type": "string", "pattern": "^STRAT-SPEC-[0-9]{4}$"}, "canonical_target_path": {"type": "string", "pattern": "^research/strategy_specs/STRAT-SPEC-[0-9]{4}\\.strategy_spec\\.json$"}}},
    "denominator": {"type": "object", "additionalProperties": false, "required": ["basis", "committed_population_count", "variant_manifest_value", "sweep_plan_value", "mismatch_policy"], "properties": {"basis": {"const": "committed_pre_registered_population_count"}, "committed_population_count": {"type": "integer", "minimum": 1}, "variant_manifest_value": {"type": "integer", "minimum": 1}, "sweep_plan_value": {"type": "integer", "minimum": 1}, "mismatch_policy": {"const": "reject"}}},
    "dataset": {"type": "object", "additionalProperties": false, "required": ["dataset_id", "snapshot_version", "path", "sha256", "market", "timeframe", "unresolved_policy"], "properties": {"dataset_id": {"type": "string", "minLength": 1}, "snapshot_version": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/definitions/hash"}, "market": {"const": "BTCUSDT_BINANCE_USDTM_PERPETUAL"}, "timeframe": {"enum": ["15m", "30m", "1h", "4h", "1d"]}, "unresolved_policy": {"const": "reject"}}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["metric", "upper_bound", "unit", "comparison", "retries_included", "mismatch_or_exceed_policy"], "properties": {"metric": {"const": "variant_attempts"}, "upper_bound": {"type": "integer", "minimum": 1}, "unit": {"const": "attempts"}, "comparison": {"const": "actual_lte_upper_bound"}, "retries_included": {"const": true}, "mismatch_or_exceed_policy": {"const": "reject"}}},
    "flags": {"type": "object", "additionalProperties": false, "required": ["authorizes_dispatch", "authorizes_execution", "authorizes_scheduler_autonomy", "authorizes_candidate_lifecycle", "authorizes_promotion_readiness", "authorizes_paper_live_runtime", "authorizes_notifications"], "properties": {"authorizes_dispatch": {"const": false}, "authorizes_execution": {"const": false}, "authorizes_scheduler_autonomy": {"const": false}, "authorizes_candidate_lifecycle": {"const": false}, "authorizes_promotion_readiness": {"const": false}, "authorizes_paper_live_runtime": {"const": false}, "authorizes_notifications": {"const": false}}}
  }
}
