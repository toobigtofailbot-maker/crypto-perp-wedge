  "entry_logic": {
    "direction": "both",
    "entry_controls": {
      "min_bars_between_entries": 16
    },
    "groups": [
      {
        "group_id": "ENTRY-GROUP-LONG-SMA-CROSSOVER-0004",
        "group_role": "required",
        "logic": "all",
        "conditions": [
          {
            "condition_id": "LONG-FAST-SMA-CROSSES-ABOVE-SLOW-SMA",
            "condition_role": "required",
            "left_operand": {
              "operand_type": "indicator_ref",
              "ref": "sma",
              "field": "value",
              "timeframe": null,
              "lookback": {
                "bars_parameter_ref": "fast_lookback_bars"
              }
            },
            "operator": "crosses_above",
            "right_operand": {
              "operand_type": "indicator_ref",
              "ref": "sma",
              "field": "value",
              "timeframe": null,
              "lookback": {
                "bars_parameter_ref": "slow_lookback_bars"
              }
            },
            "units": null,
            "notes": "Long entry event when fast SMA crosses above slow SMA."
          },
          {
            "condition_id": "LONG-CLOSE-GT-TREND-SMA",
            "condition_role": "confirming",
            "left_operand": {
              "operand_type": "data_ref",
              "ref": "close",
              "field": "close",
              "timeframe": null,
              "lookback": null
            },
            "operator": "gt",
            "right_operand": {
              "operand_type": "indicator_ref",
              "ref": "sma",
              "field": "value",
              "timeframe": null,
              "lookback": {
                "bars_parameter_ref": "trend_lookback_bars"
              }
            },
            "units": null,
            "notes": "Long-side trend confirmation: close must be above SMA(trend_lookback_bars)."
          }
        ],
        "subgroups": [],
        "notes": "Explicit long-side momentum entry group; trend confirmation is side-specific and not a shared filter.",
        "side": "long"
      },
      {
        "group_id": "ENTRY-GROUP-SHORT-SMA-CROSSOVER-0004",
        "group_role": "required",
        "logic": "all",
        "conditions": [
          {
            "condition_id": "SHORT-FAST-SMA-CROSSES-BELOW-SLOW-SMA",
            "condition_role": "required",
            "left_operand": {
              "operand_type": "indicator_ref",
              "ref": "sma",
              "field": "value",
              "timeframe": null,
              "lookback": {
                "bars_parameter_ref": "fast_lookback_bars"
              }
            },
            "operator": "crosses_below",
            "right_operand": {
              "operand_type": "indicator_ref",
              "ref": "sma",
              "field": "value",
              "timeframe": null,
              "lookback": {
                "bars_parameter_ref": "slow_lookback_bars"
              }
            },
            "units": null,
            "notes": "Short entry event when fast SMA crosses below slow SMA."
          },
          {
            "condition_id": "SHORT-CLOSE-LT-TREND-SMA",
            "condition_role": "confirming",
            "left_operand": {
              "operand_type": "data_ref",
              "ref": "close",
              "field": "close",
              "timeframe": null,
              "lookback": null
            },
            "operator": "lt",
            "right_operand": {
              "operand_type": "indicator_ref",
              "ref": "sma",
              "field": "value",
              "timeframe": null,
              "lookback": {
                "bars_parameter_ref": "trend_lookback_bars"
              }
            },
            "units": null,
            "notes": "Short-side trend confirmation: close must be below SMA(trend_lookback_bars)."
          }
        ],
        "subgroups": [],
        "notes": "Explicit short-side momentum entry group; trend confirmation is side-specific and not a shared filter.",
        "side": "short"
      }
    ],
    "notes": "Both-direction SMA crossover continuation entries use side-specific trend confirmation and fixed min_bars_between_entries=16. Throttle is fixed and not part of VM axes."
  },
