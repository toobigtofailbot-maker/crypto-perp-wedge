      "type": "integer"
    },
    "repo_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Repo Sha",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "approved_by": {
      "const": "Karl",
