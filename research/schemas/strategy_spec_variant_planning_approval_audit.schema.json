{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "strategy_spec_variant_planning_approval_audit.schema.json",
  "title": "Append-only standalone Gate C-VP approval audit record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_record_id",
    "approval_id",
    "approval_path",
    "approval_file_sha256",
    "strategy_spec_id",
    "strategy_spec_path",
    "strategy_spec_sha256",
    "gate_c_audit_path",
    "gate_c_audit_line_number",
    "gate_c_raw_record_sha256",
    "gate_c_approval_id",
    "variant_manifest_id",
    "variant_manifest_path",
    "search_family_id",
    "contract_core_sha256",
    "committed_population_count",
    "approved_at",
    "writer_version",
    "validation_outcome",
    "no_gate_q",
    "no_queue_admission",
    "no_dispatch",
    "no_research_execution",
    "no_result_population",
    "no_candidate_action",
    "no_runtime_or_paper_live"
  ],
  "properties": {
    "schema_version": {
      "const": "strategy_spec_variant_planning_approval_audit_v1"
    },
    "audit_record_id": {
      "type": "string",
      "pattern": "^VPAUDIT-VPAPP-[0-9]{8}-[A-Z0-9]{8}$"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^VPAPP-[0-9]{8}-[A-Z0-9]{8}$"
    },
    "approval_path": {
      "type": "string",
      "pattern": "^research/strategy_spec_variant_planning_approvals/VPAPP-[0-9]{8}-[A-Z0-9]{8}\\.variant_planning_approval\\.json$"
    },
    "approval_file_sha256": {
      "$ref": "#/definitions/hash"
    },
    "strategy_spec_id": {
      "type": "string",
      "pattern": "^STRAT-SPEC-[0-9]{4}$"
    },
    "strategy_spec_path": {
      "type": "string",
      "pattern": "^research/strategy_specs/STRAT-SPEC-[0-9]{4}\\.strategy_spec\\.json$"
    },
    "strategy_spec_sha256": {
      "$ref": "#/definitions/hash"
    },
    "gate_c_audit_path": {
      "const": "research/canonical_crossing_audit/strategy_spec_writes.jsonl"
    },
    "gate_c_audit_line_number": {
      "type": "integer",
      "minimum": 1
    },
    "gate_c_raw_record_sha256": {
      "$ref": "#/definitions/hash"
    },
    "gate_c_approval_id": {
      "type": "string",
      "minLength": 1
    },
    "variant_manifest_id": {
      "type": "string",
      "pattern": "^VM-[0-9]{4}$"
    },
    "variant_manifest_path": {
      "type": "string",
      "pattern": "^research/variant_manifests/VM-[0-9]{4}\\.variant_manifest\\.json$"
    },
    "search_family_id": {
      "type": "string",
      "pattern": "^SF-[A-Z0-9][A-Z0-9-]{2,126}[A-Z0-9]$"
    },
    "contract_core_sha256": {
      "$ref": "#/definitions/hash"
    },
    "committed_population_count": {
      "type": "integer",
      "minimum": 1
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "writer_version": {
      "const": "variant_planning_approval_writer_v1"
    },
    "validation_outcome": {
      "const": "passed_before_write"
    },
    "no_gate_q": {
      "const": true
    },
    "no_queue_admission": {
      "const": true
    },
    "no_dispatch": {
      "const": true
    },
    "no_research_execution": {
      "const": true
    },
    "no_result_population": {
      "const": true
    },
    "no_candidate_action": {
      "const": true
    },
    "no_runtime_or_paper_live": {
      "const": true
    }
  },
  "definitions": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
