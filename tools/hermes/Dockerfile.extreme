FROM nousresearch/hermes-agent:v2026.9.24@sha256:fca358f12efd65bfaaca05884166f15c0e2788375ca30d77061ac1ebc96452b7

# Stable source f97608f178d1ffeca59860195ab7da295f7c8e5f; only upstream
# 59559b858fb1a4578f51029112099462a431c3f1's three runtime/two test files.
LABEL org.cpw.hermes.security-reference="59559b858fb1a4578f51029112099462a431c3f1" \
      org.cpw.hermes.security-patch-sha256="1294e8e88663691f49e4b78d074460f91f9097afbd23a0e005a161f20fe78a6e"
COPY tools/hermes/upstream_patches/59559-tool-scope.patch /tmp/cpw-tool-scope.patch
RUN test "$(cat /opt/hermes/.hermes_build_sha)" = f97608f178d1ffeca59860195ab7da295f7c8e5f \
    && echo "1294e8e88663691f49e4b78d074460f91f9097afbd23a0e005a161f20fe78a6e  /tmp/cpw-tool-scope.patch" | sha256sum --check --status \
    && cd /opt/hermes \
    && git apply --check /tmp/cpw-tool-scope.patch \
    && git apply /tmp/cpw-tool-scope.patch \
    && rm /tmp/cpw-tool-scope.patch
# Inherit the sealed venv, lazy-install prohibition, PATH and s6 bootstrap.
