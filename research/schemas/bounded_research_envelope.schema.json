    "EvidenceBinding": {
      "additionalProperties": false,
      "properties": {
        "resource_uri": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Resource Uri",
          "type": "string"
        },
        "repo_path": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Repo Path",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
