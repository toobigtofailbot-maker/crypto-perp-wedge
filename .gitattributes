# Normalize text files to LF in the repository.
* text=auto eol=lf

# Source and project text.
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf

# Binary/data artifacts.
*.parquet binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.pkl binary
