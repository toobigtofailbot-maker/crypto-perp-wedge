FROM python:3.11.9-slim-bookworm@sha256:8fb099199b9f2d70342674bd9dbccd3ed03a258f26bbd1d556822c6dfc60c317
COPY requirements.lock.txt /tmp/cpw-requirements.lock.txt
RUN python -m pip install --no-cache-dir --constraint /tmp/cpw-requirements.lock.txt mcp==1.28.1 \
    && rm /tmp/cpw-requirements.lock.txt
COPY tools/hermes/canary_mcp_server.py /app/canary_mcp_server.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 65532:65532
ENTRYPOINT ["python", "/app/canary_mcp_server.py"]
