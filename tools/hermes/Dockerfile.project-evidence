FROM python:3.11.9-slim-bookworm@sha256:8fb099199b9f2d70342674bd9dbccd3ed03a258f26bbd1d556822c6dfc60c317

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PROJECT_EVIDENCE_ROOT=/project \
    PROJECT_EVIDENCE_HOST=0.0.0.0 \
    PROJECT_EVIDENCE_PORT=8765 \
    HERMES_PROPOSAL_OUTBOX=/outbox \
    HERMES_UPSTREAM_WATCH_MANIFEST=/project/tools/hermes/upstream_watch.json

WORKDIR /app

COPY requirements.lock.txt /app/requirements.lock.txt
RUN python -m pip install --no-cache-dir --requirement /app/requirements.lock.txt

COPY tools/mcp /app/tools/mcp

USER 65532:65532

EXPOSE 8765

ENTRYPOINT ["python", "-m", "tools.mcp.project_evidence.server"]
