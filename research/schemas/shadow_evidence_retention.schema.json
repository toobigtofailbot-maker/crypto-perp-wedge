{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crypto-perp-wedge.local/research/schemas/shadow_evidence_retention.schema.json",
  "title": "Shadow Evidence Retention",
  "description": "Schema for future canonical shadow-evidence retention/reference material used in later human shadow-to-paper review. The schema validates local shape and required content only; it grants no approval, readiness, transition, promotion, runtime, Tier 4, ranking, scoring, recommendation, policy, or human-gate execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "shadow_evidence_id",
    "candidate_id",
    "shadow_window",
    "d2_007_thresholds",
    "parity_result",
    "shadow_observation_lineage",
    "disclosure",
    "evidence_retention_reference",
    "mismatch_diagnostics",
    "authority_flags"
  ],
  "properties": {
    "schema_version": { "$ref": "#/definitions/schema_version" },
    "record_type": {
      "description": "Distinct shadow-evidence retention type marker.",
      "type": "string",
      "const": "shadow_evidence_retention"
    },
    "shadow_evidence_id": {
      "description": "Stable shadow-evidence retention identifier.",
      "type": "string",
      "pattern": "^SER-[0-9]{4}$"
    },
    "candidate_id": { "$ref": "#/definitions/candidate_id" },
    "shadow_window": { "$ref": "#/definitions/shadow_window" },
    "d2_007_thresholds": { "$ref": "#/definitions/d2_007_thresholds" },
    "parity_result": { "$ref": "#/definitions/parity_result" },
    "shadow_observation_lineage": {
      "description": "References to shadow observations or evidence used in human review.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/artifact_ref" },
      "uniqueItems": true
    },
    "disclosure": { "$ref": "#/definitions/disclosure" },
    "evidence_retention_reference": {
      "description": "Reference sufficient for human review of retained shadow evidence.",
      "$ref": "#/definitions/artifact_ref"
    },
    "mismatch_diagnostics": {
      "description": "Mismatch diagnostics for human decision support only; not ranking, scoring, recommendation, transition, or policy logic.",
      "$ref": "#/definitions/mismatch_diagnostics"
    },
    "authority_flags": { "$ref": "#/definitions/authority_flags" }
  },
  "definitions": {
    "schema_version": {
      "description": "Explicit Scope 6 shadow-evidence retention schema marker.",
      "type": "string",
      "const": "v1"
    },
    "candidate_id": {
      "description": "Candidate registry identifier.",
      "type": "string",
      "pattern": "^H-[0-9]{3}$"
    },
    "repo_relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id_or_label", "artifact_path"],
      "properties": {
        "artifact_id_or_label": { "type": "string", "minLength": 1 },
        "artifact_path": { "$ref": "#/definitions/repo_relative_path" },
        "notes": { "type": "string" }
      }
    },
    "shadow_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_utc", "end_utc", "calendar_days_observed"],
      "properties": {
        "start_utc": { "$ref": "#/definitions/utc_timestamp" },
        "end_utc": { "$ref": "#/definitions/utc_timestamp" },
        "calendar_days_observed": {
          "type": "integer",
          "minimum": 14
        }
      }
    },
    "d2_007_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_shadow_window_calendar_days",
        "pnl_deviation_max",
        "trade_count_deviation_max"
      ],
      "properties": {
        "minimum_shadow_window_calendar_days": { "type": "integer", "const": 14 },
        "pnl_deviation_max": { "type": "number", "const": 0.1 },
        "trade_count_deviation_max": { "type": "number", "const": 0.05 }
      }
    },
    "parity_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_pnl_deviation",
        "observed_trade_count_deviation",
        "parity_result_evidence_reference_or_attestation"
      ],
      "properties": {
        "observed_pnl_deviation": {
          "description": "Observed PnL deviation for D2-007 review; this value does not determine readiness.",
          "type": "number",
          "minimum": 0
        },
        "observed_trade_count_deviation": {
          "description": "Observed trade-count deviation for D2-007 review; this value does not determine readiness.",
          "type": "number",
          "minimum": 0
        },
        "parity_result_evidence_reference_or_attestation": { "$ref": "#/definitions/artifact_ref" }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interruptions",
        "invalid_observations",
        "missing_data",
        "observation_resets"
      ],
      "properties": {
        "interruptions": { "$ref": "#/definitions/disclosure_items" },
        "invalid_observations": { "$ref": "#/definitions/disclosure_items" },
        "missing_data": { "$ref": "#/definitions/disclosure_items" },
        "observation_resets": { "$ref": "#/definitions/disclosure_items" }
      }
    },
    "disclosure_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "evidence_reference_or_attestation"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "evidence_reference_or_attestation": { "$ref": "#/definitions/artifact_ref" }
        }
      }
    },
    "mismatch_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_support_only",
        "ranking_authority",
        "scoring_authority",
        "recommendation_authority",
        "transition_logic_authority",
        "diagnostic_references"
      ],
      "properties": {
        "decision_support_only": { "type": "boolean", "const": true },
        "ranking_authority": { "type": "boolean", "const": false },
        "scoring_authority": { "type": "boolean", "const": false },
        "recommendation_authority": { "type": "boolean", "const": false },
        "transition_logic_authority": { "type": "boolean", "const": false },
        "diagnostic_references": {
          "type": "array",
          "items": { "$ref": "#/definitions/artifact_ref" },
          "uniqueItems": true
        },
        "notes": { "type": "string" }
      }
    },
    "authority_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_readiness_authority",
        "transition_authority",
        "ranking_authority",
        "scoring_authority",
        "recommendation_authority",
        "gate_execution_authority",
        "runtime_authority",
        "tier4_authority"
      ],
      "properties": {
        "candidate_readiness_authority": { "type": "boolean", "const": false },
        "transition_authority": { "type": "boolean", "const": false },
        "ranking_authority": { "type": "boolean", "const": false },
        "scoring_authority": { "type": "boolean", "const": false },
        "recommendation_authority": { "type": "boolean", "const": false },
        "gate_execution_authority": { "type": "boolean", "const": false },
        "runtime_authority": { "type": "boolean", "const": false },
        "tier4_authority": { "type": "boolean", "const": false }
      }
    }
  }
}
