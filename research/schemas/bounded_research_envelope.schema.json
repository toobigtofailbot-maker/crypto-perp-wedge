          },
          "title": "Dispositions",
          "type": "array"
        },
        "stop_conditions": {
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "title": "Stop Conditions",
          "type": "array"
        },
        "escalation_conditions": {
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "title": "Escalation Conditions",
          "type": "array"
        }
      },
      "required": [
        "provenance_requirements",
        "memory_indexing",
        "memory_dedup",
        "dispositions",
        "stop_conditions",
        "escalation_conditions"
      ],
      "title": "EvidencePolicy",
      "type": "object"
    },
    "Exclusion": {
      "additionalProperties": false,
