      "type": "object"
    },
    "EvidencePolicy": {
      "additionalProperties": false,
      "properties": {
        "provenance_requirements": {
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "title": "Provenance Requirements",
          "type": "array"
        },
        "memory_indexing": {
          "const": "index_not_truth",
