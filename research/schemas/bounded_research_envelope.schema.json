      "type": "string"
    },
    "approved_at": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Approved At",
      "type": "string"
    },
    "contamination_domain_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "title": "Contamination Domain Id",
      "type": "string"
    },
    "surface": {
      "$ref": "#/$defs/ResearchSurface"
    },
    "search_policy": {
      "$ref": "#/$defs/SearchPolicy"
