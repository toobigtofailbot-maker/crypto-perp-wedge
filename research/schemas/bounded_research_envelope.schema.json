      "type": "object"
    },
    "Policies": {
      "additionalProperties": false,
      "properties": {
        "duplicate_policy": {
          "enum": [
            "reject_and_charge",
            "reuse_prior_result"
          ],
          "title": "Duplicate Policy",
          "type": "string"
        },
        "invalid_trial_policy": {
          "const": "reject_before_scientific_execution",
          "title": "Invalid Trial Policy",
          "type": "string"
        },
        "failed_software_trial_policy": {
          "const": "retry_same_scientific_trial_id",
