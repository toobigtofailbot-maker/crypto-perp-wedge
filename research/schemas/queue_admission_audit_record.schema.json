{
  "$schema":"http://json-schema.org/draft-07/schema#","$id":"queue_admission_audit_record.schema.json","title":"Append-only queue admission audit record","type":"object","additionalProperties":false,
  "required":["schema_version","audit_record_id","queue_item_id","queue_item_path","queue_item_sha256","gate_q_approval_id","gate_q_approval_path","gate_q_approval_file_sha256","gate_q_approval_core_sha256","eligibility_report","strategy_spec_id","strategy_spec_path","strategy_spec_sha256","variant_manifest_path","variant_manifest_sha256","sweep_plan_path","sweep_plan_sha256","admitted_at","writer_version","validation_outcome","no_dispatch","no_execution"],
  "properties":{"schema_version":{"const":"queue_admission_audit_record_v1"},"audit_record_id":{"type":"string","pattern":"^QAUDIT-QI-[0-9]{8}-[A-Z0-9]{8}$"},"queue_item_id":{"type":"string","pattern":"^QI-[0-9]{8}-[A-Z0-9]{8}$"},"queue_item_path":{"type":"string","pattern":"^research/queue/admissions/QI-[0-9]{8}-[A-Z0-9]{8}\\.queue_item\\.json$"},"queue_item_sha256":{"$ref":"#/definitions/hash"},"gate_q_approval_id":{"type":"string","pattern":"^GATE-Q-[A-Z0-9][A-Z0-9-]{2,63}$"},"gate_q_approval_path":{"type":"string","pattern":"^research/queue/gate_q_approvals/GATE-Q-[A-Z0-9][A-Z0-9-]{2,63}\\.gate_q_approval\\.json$"},"gate_q_approval_file_sha256":{"$ref":"#/definitions/hash"},"gate_q_approval_core_sha256":{"$ref":"#/definitions/hash"},"eligibility_report":{"$ref":"gate_q_approval.schema.json#/definitions/eligibility_report_ref"},"strategy_spec_id":{"type":"string","pattern":"^STRAT-SPEC-[0-9]{4}$"},"strategy_spec_path":{"type":"string","pattern":"^research/strategy_specs/STRAT-SPEC-[0-9]{4}\\.strategy_spec\\.json$"},"strategy_spec_sha256":{"$ref":"#/definitions/hash"},"variant_manifest_path":{"type":"string","minLength":1},"variant_manifest_sha256":{"$ref":"#/definitions/hash"},"sweep_plan_path":{"type":"string","minLength":1},"sweep_plan_sha256":{"$ref":"#/definitions/hash"},"variant_planning_approval_id":{"type":"string","pattern":"^VPAPP-[0-9]{8}-[A-Z0-9]{8}$"},"variant_planning_approval_path":{"type":"string","pattern":"^research/strategy_spec_variant_planning_approvals/VPAPP-[0-9]{8}-[A-Z0-9]{8}\\.variant_planning_approval\\.json$"},"variant_planning_approval_file_sha256":{"$ref":"#/definitions/hash"},"variant_planning_approval_contract_core_sha256":{"$ref":"#/definitions/hash"},"admitted_at":{"type":"string","format":"date-time"},"writer_version":{"type":"string","minLength":1},"validation_outcome":{"const":"passed_before_admission"},"no_dispatch":{"const":true},"no_execution":{"const":true}},
  "definitions":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}
}
