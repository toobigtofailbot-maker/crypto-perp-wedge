{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crypto-perp-wedge.local/research/schemas/candidate_lifecycle_registry.schema.json",
  "title": "Candidate Lifecycle Registry",
  "description": "Candidate lifecycle registry shape. This schema defines review/evidence records only and creates no runtime, paper/live, capital, broker, exchange, OMS, reconciliation, risk, promotion, or trading authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "registry_status",
    "non_authority_declaration",
    "transition_rules",
    "candidates",
    "append_only_ledger",
    "validation_summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "candidate_lifecycle_registry.v1"
    },
    "registry_id": {
      "type": "string",
      "pattern": "^CANDIDATE-REGISTRY-(EXAMPLE-|FIXTURE-)?[0-9]{4}$"
    },
    "registry_status": {
      "type": "string",
      "enum": ["example_fixture", "test_fixture", "unpopulated", "candidate_review", "archived"]
    },
    "non_authority_declaration": {
      "$ref": "#/definitions/non_authority_declaration"
    },
    "transition_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_edges", "forbidden_principles"],
      "properties": {
        "allowed_edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from_status", "to_status", "required_gate", "notes"],
            "properties": {
              "from_status": { "$ref": "#/definitions/candidate_status" },
              "to_status": { "$ref": "#/definitions/candidate_status" },
              "required_gate": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "forbidden_principles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/definitions/candidate" },
      "uniqueItems": true
    },
    "append_only_ledger": {
      "type": "array",
      "items": { "$ref": "#/definitions/audit_event" },
      "uniqueItems": true
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_only",
        "real_candidate_registered",
        "lifecycle_engine_implemented",
        "paper_live_authority_created",
        "runtime_authority_created",
        "capital_authority_created"
      ],
      "properties": {
        "fixture_only": { "type": "boolean" },
        "real_candidate_registered": { "type": "boolean" },
        "lifecycle_engine_implemented": { "type": "boolean", "const": false },
        "paper_live_authority_created": { "type": "boolean", "const": false },
        "runtime_authority_created": { "type": "boolean", "const": false },
        "capital_authority_created": { "type": "boolean", "const": false },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "candidate_status": {
      "type": "string",
      "enum": [
        "proposed",
        "validated_research",
        "paper_candidate",
        "paper_running",
        "promoted_live",
        "rejected",
        "demoted",
        "retired"
      ]
    },
    "timeframe": {
      "type": "string",
      "enum": ["15m", "30m", "1h", "4h", "1d"]
    },
    "non_authority_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_candidate_approval",
        "not_paper_live_authority",
        "not_runtime_authority",
        "not_promotion_authority",
        "not_trading_recommendation",
        "not_broker_exchange_authority",
        "not_capital_authority"
      ],
      "properties": {
        "not_candidate_approval": { "type": "boolean", "const": true },
        "not_paper_live_authority": { "type": "boolean", "const": true },
        "not_runtime_authority": { "type": "boolean", "const": true },
        "not_promotion_authority": { "type": "boolean", "const": true },
        "not_trading_recommendation": { "type": "boolean", "const": true },
        "not_broker_exchange_authority": { "type": "boolean", "const": true },
        "not_capital_authority": { "type": "boolean", "const": true },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_ref",
        "relationship",
        "authority_boundary"
      ],
      "properties": {
        "artifact_type": {
          "type": "string",
          "enum": [
            "strategy_spec",
            "variant_manifest",
            "sweep_plan",
            "result_population",
            "screen_diagnostic",
            "experiment_plan",
            "experiment_report",
            "trial_log",
            "decision_record",
            "lifecycle_change",
            "walk_forward_oos",
            "robustness_report",
            "monte_carlo_bootstrap",
            "paper_shadow",
            "live_approval",
            "rejection_record",
            "demotion_record",
            "retirement_record",
            "design_doc",
            "status_entry",
            "candidate_review_packet",
            "formalizer_artifact",
            "bridge_review_packet",
            "denominator_ledger",
            "robustness_diagnostics",
            "robustness_review_packet",
            "operator_approval",
            "crossing_approval"
          ]
        },
        "artifact_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "type": "string",
          "enum": [
            "source_lineage",
            "canonical_evidence",
            "validation_evidence",
            "paper_shadow_evidence",
            "live_gate_evidence",
            "decision_evidence",
            "blocking_evidence",
            "supersession_evidence",
            "context"
          ]
        },
        "authority_boundary": {
          "type": "string",
          "enum": [
            "review_reference_only",
            "evidence_link_only",
            "non_authoritative_context"
          ]
        },
        "identity_hash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "review_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by",
        "review_owner",
        "gate_owner",
        "review_due_at",
        "unresolved_questions"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "review_owner": {
          "type": "string",
          "minLength": 1
        },
        "gate_owner": {
          "type": "string",
          "minLength": 1
        },
        "review_due_at": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "decision_notes": {
          "type": "string"
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_status",
        "display_name",
        "strategy_family",
        "description",
        "market",
        "instrument",
        "primary_timeframe",
        "allowed_confirmation_timeframes",
        "source_refs",
        "evidence_links",
        "lifecycle_event_refs",
        "review_metadata",
        "non_authority_declaration"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^(CANDIDATE-(EXAMPLE-|FIXTURE-)?[0-9]{4}|H-[0-9]{3})$"
        },
        "candidate_status": { "$ref": "#/definitions/candidate_status" },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "strategy_family": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "market": {
          "type": "string",
          "const": "crypto_perpetual"
        },
        "instrument": {
          "type": "string",
          "const": "BTCUSDT"
        },
        "primary_timeframe": { "$ref": "#/definitions/timeframe" },
        "allowed_confirmation_timeframes": {
          "type": "array",
          "items": { "$ref": "#/definitions/timeframe" },
          "uniqueItems": true
        },
        "source_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy_spec_refs",
            "variant_manifest_refs",
            "sweep_plan_refs",
            "source_design_refs",
            "approval_note_refs"
          ],
          "properties": {
            "strategy_spec_refs": {
              "type": "array",
              "items": { "$ref": "#/definitions/artifact_ref" }
            },
            "variant_manifest_refs": {
              "type": "array",
              "items": { "$ref": "#/definitions/artifact_ref" }
            },
            "sweep_plan_refs": {
              "type": "array",
              "items": { "$ref": "#/definitions/artifact_ref" }
            },
            "source_design_refs": {
              "type": "array",
              "items": { "$ref": "#/definitions/artifact_ref" }
            },
            "approval_note_refs": {
              "type": "array",
              "items": { "$ref": "#/definitions/artifact_ref" }
            }
          }
        },
        "evidence_links": {
          "type": "array",
          "items": { "$ref": "#/definitions/artifact_ref" }
        },
        "lifecycle_event_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CLE-(EXAMPLE-|FIXTURE-)?[0-9]{4}$"
          },
          "uniqueItems": true
        },
        "review_metadata": { "$ref": "#/definitions/review_metadata" },
        "blocking_reason": {
          "type": ["string", "null"]
        },
        "required_next_review": {
          "type": ["string", "null"]
        },
        "non_authority_declaration": {
          "$ref": "#/definitions/non_authority_declaration"
        }
      }
    },
    "sha256_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_review_packet_path",
        "candidate_review_packet_hash",
        "formalizer_artifact_path",
        "formalizer_artifact_hash",
        "bridge_artifact_path",
        "bridge_artifact_hash",
        "robustness_artifact_path",
        "robustness_artifact_hash",
        "denominator_ledger_path",
        "denominator_ledger_hash"
      ],
      "properties": {
        "candidate_review_packet_path": { "type": "string", "minLength": 1 },
        "candidate_review_packet_hash": { "$ref": "#/definitions/sha256_hash" },
        "formalizer_artifact_path": { "type": "string", "minLength": 1 },
        "formalizer_artifact_hash": { "$ref": "#/definitions/sha256_hash" },
        "formalizer_draft_strategy_spec_path": { "type": ["string", "null"], "minLength": 1 },
        "formalizer_draft_strategy_spec_hash": {
          "oneOf": [
            { "$ref": "#/definitions/sha256_hash" },
            { "type": "null" }
          ]
        },
        "bridge_artifact_path": { "type": "string", "minLength": 1 },
        "bridge_artifact_hash": { "$ref": "#/definitions/sha256_hash" },
        "bridge_runner_artifact_path": { "type": ["string", "null"], "minLength": 1 },
        "bridge_runner_artifact_hash": {
          "oneOf": [
            { "$ref": "#/definitions/sha256_hash" },
            { "type": "null" }
          ]
        },
        "robustness_artifact_path": { "type": "string", "minLength": 1 },
        "robustness_artifact_hash": { "$ref": "#/definitions/sha256_hash" },
        "robustness_review_packet_path": { "type": ["string", "null"], "minLength": 1 },
        "robustness_review_packet_hash": {
          "oneOf": [
            { "$ref": "#/definitions/sha256_hash" },
            { "type": "null" }
          ]
        },
        "denominator_ledger_path": { "type": "string", "minLength": 1 },
        "denominator_ledger_hash": { "$ref": "#/definitions/sha256_hash" },
        "operator_approval_path": { "type": ["string", "null"], "minLength": 1 },
        "operator_approval_hash": {
          "oneOf": [
            { "$ref": "#/definitions/sha256_hash" },
            { "type": "null" }
          ]
        },
        "crossing_approval_path": { "type": ["string", "null"], "minLength": 1 },
        "crossing_approval_hash": {
          "oneOf": [
            { "$ref": "#/definitions/sha256_hash" },
            { "type": "null" }
          ]
        }
      }
    },
    "denominator_row_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant_id", "trial_status", "status_reason"],
      "properties": {
        "variant_id": { "type": "string", "minLength": 1 },
        "trial_status": {
          "type": "string",
          "enum": ["completed", "failed", "invalid", "pruned", "blocked"]
        },
        "status_reason": { "type": "string", "minLength": 1 }
      }
    },
    "denominator_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_count",
        "failed_count",
        "invalid_count",
        "pruned_count",
        "blocked_count",
        "declared_trial_count",
        "all_source_rows_preserved",
        "full_ledger_path",
        "full_ledger_hash",
        "row_disposition"
      ],
      "properties": {
        "completed_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "invalid_count": { "type": "integer", "minimum": 0 },
        "pruned_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "declared_trial_count": { "type": "integer", "minimum": 0 },
        "all_source_rows_preserved": { "type": "boolean", "const": true },
        "full_ledger_path": { "type": "string", "minLength": 1 },
        "full_ledger_hash": { "$ref": "#/definitions/sha256_hash" },
        "row_disposition": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/denominator_row_disposition" }
        }
      }
    },
    "diagnostic_skip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostic", "reason"],
      "properties": {
        "diagnostic": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "missing_diagnostic_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "performed"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "performed": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "queued_follow_up": { "type": "boolean" },
        "fabricated_per_trade_data": { "type": "boolean", "const": false }
      }
    },
    "diagnostics_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_diagnostics",
        "skipped_diagnostics",
        "skipped_reasons",
        "missing_diagnostics",
        "unsupported_diagnostics"
      ],
      "properties": {
        "completed_diagnostics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "skipped_diagnostics": {
          "type": "array",
          "items": { "$ref": "#/definitions/diagnostic_skip" }
        },
        "skipped_reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "missing_diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["per_trade", "oos_walkforward", "funding_stress"],
          "properties": {
            "per_trade": { "$ref": "#/definitions/missing_diagnostic_state" },
            "oos_walkforward": { "$ref": "#/definitions/missing_diagnostic_state" },
            "funding_stress": { "$ref": "#/definitions/missing_diagnostic_state" }
          }
        },
        "unsupported_diagnostics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "data_availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warnings", "blockers", "coverage_classes", "constraint_classes", "caveats"],
      "properties": {
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "coverage_classes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "constraint_classes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "caveats": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "funding_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["funding_cost_mode", "funding_stress_status"],
      "properties": {
        "funding_cost_mode": {
          "type": "string",
          "enum": ["off", "on", "not_run", "unknown"]
        },
        "funding_stress_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "performed"],
          "properties": {
            "status": { "type": "string", "minLength": 1 },
            "performed": { "type": "boolean" },
            "skipped_reason": { "type": ["string", "null"] }
          }
        }
      }
    },
    "crossing_non_authority_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_evidence",
        "not_candidate_authority",
        "not_promotion_authority",
        "not_ranking_authority",
        "not_paper_live_readiness",
        "not_trading_signal",
        "human_review_required"
      ],
      "properties": {
        "not_evidence": { "type": "boolean", "const": true },
        "not_candidate_authority": { "type": "boolean", "const": true },
        "not_promotion_authority": { "type": "boolean", "const": true },
        "not_ranking_authority": { "type": "boolean", "const": true },
        "not_paper_live_readiness": { "type": "boolean", "const": true },
        "not_trading_signal": { "type": "boolean", "const": true },
        "human_review_required": { "type": "boolean", "const": true }
      }
    },
    "append_only_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "append_only",
        "new_event_only",
        "no_overwrite",
        "correction_requires_supersession_event",
        "source_hashes_preserved",
        "denominator_snapshot_preserved",
        "caveats_preserved",
        "missing_diagnostics_preserved"
      ],
      "properties": {
        "append_only": { "type": "boolean", "const": true },
        "new_event_only": { "type": "boolean", "const": true },
        "no_overwrite": { "type": "boolean", "const": true },
        "correction_requires_supersession_event": { "type": "boolean", "const": true },
        "source_hashes_preserved": { "type": "boolean", "const": true },
        "denominator_snapshot_preserved": { "type": "boolean", "const": true },
        "caveats_preserved": { "type": "boolean", "const": true },
        "missing_diagnostics_preserved": { "type": "boolean", "const": true }
      }
    },
    "candidate_review_packet_crossing_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_lineage",
        "denominator_snapshot",
        "diagnostics_summary",
        "data_availability",
        "funding",
        "non_authority_flags",
        "append_only_semantics"
      ],
      "properties": {
        "source_lineage": { "$ref": "#/definitions/source_lineage" },
        "denominator_snapshot": { "$ref": "#/definitions/denominator_snapshot" },
        "diagnostics_summary": { "$ref": "#/definitions/diagnostics_summary" },
        "data_availability": { "$ref": "#/definitions/data_availability" },
        "funding": { "$ref": "#/definitions/funding_summary" },
        "non_authority_flags": { "$ref": "#/definitions/crossing_non_authority_flags" },
        "append_only_semantics": { "$ref": "#/definitions/append_only_semantics" }
      }
    },
    "audit_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_sequence",
        "candidate_id",
        "event_type",
        "timestamp_utc",
        "actor",
        "gate",
        "from_status",
        "to_status",
        "reason",
        "related_evidence_links",
        "blocking_or_exception_refs",
        "non_authority_declaration"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^CLE-(EXAMPLE-|FIXTURE-)?[0-9]{4}$"
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^(CANDIDATE-(EXAMPLE-|FIXTURE-)?[0-9]{4}|H-[0-9]{3})$"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "proposed",
            "validated",
            "paper_candidate_approved",
            "paper_started",
            "paper_completed",
            "candidate_review_packet_crossed",
            "promoted",
            "rejected",
            "demoted",
            "retired",
            "override_exception"
          ]
        },
        "timestamp_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "from_status": {
          "oneOf": [
            { "$ref": "#/definitions/candidate_status" },
            { "type": "null" }
          ]
        },
        "to_status": { "$ref": "#/definitions/candidate_status" },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "related_evidence_links": {
          "type": "array",
          "items": { "$ref": "#/definitions/artifact_ref" }
        },
        "blocking_or_exception_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/artifact_ref" }
        },
        "non_authority_declaration": {
          "$ref": "#/definitions/non_authority_declaration"
        },
        "crossing_evidence": {
          "$ref": "#/definitions/candidate_review_packet_crossing_evidence"
        }
      },
